---
import { siteConfig } from "../data/site";
---

<div class="mx-auto w-full max-w-[15.5rem] sm:max-w-sm lg:max-w-none">
  <img
    src={siteConfig.image}
    alt={siteConfig.author.name}
    width="640"
    height="480"
    class="aspect-[4/3] w-full rounded-3xl object-cover shadow-xl shadow-black/10"
    loading="eager"
  />
</div>
