---
import ThemeToggle from "./ThemeToggle.astro";
import { siteConfig } from "../data/site";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHome = currentPath === "/" || currentPath === "/index.html";
const isPublications = currentPath === "/publications";
const isCv = currentPath === "/cv";
const isCoffee = currentPath === "/coffee";

const navClass =
  "inline-flex h-9 items-center rounded-lg px-2 text-xs font-medium transition-colors sm:px-3 sm:text-sm";
---

<style is:global>
  .site-header a,
  .site-header a:hover {
    color: inherit;
  }
</style>

<header
  class="site-header sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/88 text-[var(--color-text)] backdrop-blur-xl transition-colors duration-200"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-3 sm:px-6">
    <a
      href="/"
      class="flex min-w-0 shrink-0 items-center gap-2 font-semibold transition-colors hover:text-[var(--color-accent)]"
      aria-label={`${siteConfig.title}, home`}
    >
      <img src="/favicon.png" alt="" class="h-7 w-7 shrink-0 rounded-full" />
      <span class="hidden text-base sm:inline">{siteConfig.title}</span>
      <span class="text-sm sm:hidden">{siteConfig.shortTitle}</span>
    </a>

    <div class="flex min-w-0 items-center gap-1 sm:gap-2">
      <nav class="flex items-center gap-0.5" aria-label="Primary navigation">
        <a
          href="/"
          aria-current={isHome ? "page" : undefined}
          class:list={[
            navClass,
            isHome
              ? "bg-[var(--color-surface-hover)] text-[var(--color-accent)]"
              : "text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-text)]",
          ]}
        >Bio</a>
        <a
          href="/publications"
          aria-current={isPublications ? "page" : undefined}
          class:list={[
            navClass,
            isPublications
              ? "bg-[var(--color-surface-hover)] text-[var(--color-accent)]"
              : "text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-text)]",
          ]}
        >
          <span class="sm:hidden">Papers</span>
          <span class="hidden sm:inline">Publications</span>
        </a>
        <a
          href="/cv"
          aria-current={isCv ? "page" : undefined}
          class:list={[
            navClass,
            isCv
              ? "bg-[var(--color-surface-hover)] text-[var(--color-accent)]"
              : "text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-text)]",
          ]}
        >CV</a>
      </nav>

      <div class="hidden h-5 w-px bg-[var(--color-border)] lg:block"></div>

      <nav class="hidden items-center lg:flex" aria-label="External links">
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener"
          class="flex h-9 w-9 items-center justify-center rounded-full text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-text)]"
          aria-label="GitHub"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2.23c-3.34.73-4.03-1.42-4.03-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 6.8c1.02 0 2.05.14 3.01.4 2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.3c0 .32.19.69.8.57A12 12 0 0 0 12 0Z"></path>
          </svg>
        </a>
        <a
          href={siteConfig.social.scholar}
          target="_blank"
          rel="noopener"
          class="flex h-9 w-9 items-center justify-center rounded-full text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-text)]"
          aria-label="Google Scholar"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M5.24 13.77 0 9.5 12 0l12 9.5-5.24 4.27A7.5 7.5 0 0 0 12 9.5a7.5 7.5 0 0 0-6.76 4.27ZM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14Z"></path>
          </svg>
        </a>
        <a
          href="/coffee"
          aria-current={isCoffee ? "page" : undefined}
          class:list={[
            "flex h-9 w-9 items-center justify-center rounded-full text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-text)]",
            isCoffee && "bg-[var(--color-surface-hover)] text-[var(--color-accent)]",
          ]}
          aria-label="Coffee guide"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
            <path d="M6 2v2M10 2v2M14 2v2"></path>
          </svg>
        </a>
      </nav>

      <a
        href="/coffee"
        aria-current={isCoffee ? "page" : undefined}
        class:list={[
          "flex h-9 w-9 items-center justify-center rounded-full text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-text)] lg:hidden",
          isCoffee && "bg-[var(--color-surface-hover)] text-[var(--color-accent)]",
        ]}
        aria-label="Coffee guide"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
          <path d="M6 2v2M10 2v2M14 2v2"></path>
        </svg>
      </a>

      <ThemeToggle />
    </div>
  </div>
</header>
