---
import { siteConfig } from "../data/site";

interface Author {
  name: string;
  highlight: boolean;
}

interface Link {
  type: string;
  url: string;
  label: string;
}

interface Citation {
  type: "article" | "inproceedings" | "misc" | "unpublished";
  key: string;
  authors: string[];
  booktitle?: string;
  journal?: string;
  series?: string;
  volume?: string;
  number?: string;
  pages?: string;
  publisher?: string;
  address?: string;
  isbn?: string;
  doi?: string;
  url?: string;
  month?: string;
  eprint?: string;
  archivePrefix?: string;
  primaryClass?: string;
}

interface Props {
  publication: {
    authors: Author[];
    title: string;
    topic?: string;
    venue?: string;
    year: number;
    abstract?: string;
    links?: Link[];
    highlights?: string[];
    status?: "peer-reviewed" | "preprint";
    citation: Citation;
  };
  index?: number;
}

const { publication, index = 0 } = Astro.props;
const paperLink = publication.links?.find((l) => l.type === "paper");
const codeLink = publication.links?.find((l) => l.type === "code");
const otherLinks = publication.links?.filter((l) => l.type !== "paper" && l.type !== "code") || [];
const topicColor = publication.topic
  ? siteConfig.topics[publication.topic as keyof typeof siteConfig.topics]?.color
  : undefined;
const abstractId = `abstract-${index}`;
const abstractToggleId = `abstract-toggle-${index}`;
const actionClass =
  "publication-action inline-flex h-8 items-center justify-center gap-1.5 rounded-lg border border-[var(--color-border)] bg-transparent px-2.5 text-xs font-medium transition-colors hover:border-[var(--color-accent)]/40 hover:bg-[var(--color-surface-hover)]";

const citationFields = [
  ["author", publication.citation.authors.join(" and ")],
  ["title", `{${publication.title}}`],
  ["booktitle", publication.citation.booktitle],
  ["journal", publication.citation.journal],
  ["series", publication.citation.series],
  ["volume", publication.citation.volume],
  ["number", publication.citation.number],
  ["pages", publication.citation.pages],
  ["publisher", publication.citation.publisher],
  ["address", publication.citation.address],
  ["isbn", publication.citation.isbn],
  ["doi", publication.citation.doi],
  ["url", publication.citation.url],
  ["month", publication.citation.month],
  ["eprint", publication.citation.eprint],
  ["archivePrefix", publication.citation.archivePrefix],
  ["primaryClass", publication.citation.primaryClass],
  ["year", String(publication.year)],
].filter((field): field is [string, string] => Boolean(field[1]));

const bibtex = [
  `@${publication.citation.type}{${publication.citation.key},`,
  ...citationFields.map(([name, value]) => `  ${name} = {${value}},`),
  `}`,
].join("\n");
---

<article
  id={publication.citation.key}
  class="publication-row scroll-mt-36 overflow-hidden rounded-xl border bg-[var(--color-surface)] transition-colors hover:bg-[var(--color-surface-hover)]/35"
  style={topicColor
    ? `border-color: color-mix(in srgb, ${topicColor} 20%, var(--color-border)); border-left: 2px solid ${topicColor};`
    : `border-color: var(--color-border);`}
  itemscope
  itemtype="https://schema.org/ScholarlyArticle"
>
  <div class="grid gap-3 p-3.5 sm:grid-cols-[3.75rem_minmax(0,1fr)] sm:p-4 lg:grid-cols-[3.75rem_minmax(0,1fr)_auto] lg:items-start">
    <div>
      <span class="block font-mono text-sm font-semibold text-[var(--color-accent)]" itemprop="datePublished">
        {publication.year}
      </span>
    </div>

    <div class="min-w-0">
      <h3 class="text-base font-semibold leading-snug tracking-[-0.01em] text-[var(--color-text)]" itemprop="name">
        {publication.title}
      </h3>

      <div class="mt-1 text-xs leading-5 text-[var(--color-text-secondary)] sm:text-sm">
        {publication.authors.map((author, i) => (
          <>
            {author.highlight ? (
              <span class="font-medium text-[var(--color-accent)]" itemprop="author">{author.name}</span>
            ) : (
              <span itemprop="author">{author.name}</span>
            )}
            {i < publication.authors.length - 1 && ", "}
          </>
        ))}
      </div>

      <div class="text-xs leading-5 text-[var(--color-text-secondary)]">
        {publication.venue && <span itemprop="publisher">{publication.venue}</span>}
        {publication.status === "preprint" && (
          <span class="ml-2 inline-flex rounded-full border border-[var(--color-accent)]/25 bg-[var(--color-accent)]/8 px-2 py-0.5 font-medium text-[var(--color-accent)]">
            Preprint
          </span>
        )}
      </div>

      {publication.highlights && publication.highlights.length > 0 && (
        <div class="mt-1.5 flex flex-wrap gap-x-2.5 gap-y-1 lg:flex-nowrap">
          {publication.highlights.map((h) => (
            <span class="inline-flex items-center gap-1 text-[0.68rem] font-medium leading-4 text-[var(--color-highlight)] lg:whitespace-nowrap">
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="m12 2 2.7 5.47 6.04.88-4.37 4.26 1.03 6.02L12 15.79l-5.4 2.84 1.03-6.02-4.37-4.26 6.04-.88L12 2Z"></path>
              </svg>
              {h}
            </span>
          ))}
        </div>
      )}
    </div>

    <div class="grid w-full grid-cols-2 gap-1.5 sm:col-start-2 sm:w-[13.5rem] lg:col-start-3">
    {
      publication.abstract && (
        <button
          id={abstractToggleId}
          type="button"
          class={`abstract-toggle cursor-pointer ${actionClass}`}
          aria-expanded="false"
          aria-controls={abstractId}
          aria-label={`Show abstract for ${publication.title}`}
        >
          <svg
            class="toggle-chevron w-3.5 h-3.5 transition-transform duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9" />
          </svg>
          Abstract
        </button>
      )
    }

    <button
      type="button"
      class={`bibtex-button cursor-pointer ${actionClass}`}
      data-bibtex={bibtex}
      aria-label={`Copy BibTeX citation for ${publication.title}`}
    >
      <svg
        class="w-3.5 h-3.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
        ></path>
      </svg>
      BibTeX
    </button>

    {
      paperLink && (
        <a
          href={paperLink.url}
          target="_blank"
          rel="noopener"
          class={actionClass}
          itemprop="url"
        >
          <svg
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
            <polyline points="10 9 9 9 8 9" />
          </svg>
          {paperLink.label}
        </a>
      )
    }

    {
      codeLink && (
        <a
          href={codeLink.url}
          target="_blank"
          rel="noopener"
          class={actionClass}
        >
          <svg
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
          </svg>
          {codeLink.label}
        </a>
      )
    }

    {
      otherLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener"
          class={actionClass}
        >
          <svg
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
            <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
            <line x1="12" y1="22.08" x2="12" y2="12" />
          </svg>
          {link.label}
        </a>
      ))
    }
    </div>
  </div>

  <!-- Collapsible Abstract -->
  {
    publication.abstract && (
      <div
        id={abstractId}
        class="publication-abstract grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out"
        itemprop="abstract"
        role="region"
        aria-label={`Abstract for ${publication.title}`}
        aria-hidden="true"
      >
        <div class="overflow-hidden">
          <div class="border-t border-[var(--color-border)] px-4 pb-4 pt-3 sm:ml-[4.75rem]">
            <p class="max-w-4xl text-justify text-sm leading-relaxed text-[var(--color-text-secondary)]">
              {publication.abstract}
            </p>
          </div>
        </div>
      </div>
    )
  }
</article>

<style>
  .publication-action {
    color: var(--color-text-secondary) !important;
  }

  .publication-action:hover {
    color: var(--color-accent) !important;
  }
</style>

<script>
  function initPublicationCards() {
    // Abstract toggles
    document.querySelectorAll(".abstract-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const card = btn.closest("article");
        const abstract = card?.querySelector(".publication-abstract");
        const chevron = btn.querySelector(".toggle-chevron");
        if (!abstract) return;

        const isOpen = abstract.classList.contains("grid-rows-[1fr]");
        abstract.classList.toggle("grid-rows-[0fr]", isOpen);
        abstract.classList.toggle("grid-rows-[1fr]", !isOpen);
        chevron?.classList.toggle("rotate-180", !isOpen);
        (btn as HTMLElement).setAttribute("aria-expanded", String(!isOpen));
        (btn as HTMLElement).setAttribute(
          "aria-label",
          `${isOpen ? "Show" : "Hide"} abstract for ${card?.querySelector("h3")?.textContent?.trim() || "publication"}`,
        );
        abstract.setAttribute("aria-hidden", String(isOpen));
      });
    });

    // BibTeX copy
    document.querySelectorAll(".bibtex-button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const el = btn as HTMLElement;
        const bib = el.dataset.bibtex;
        if (!bib) {
          showToast("Citation data is unavailable", true);
          return;
        }

        navigator.clipboard.writeText(bib).then(
          () => showToast("Citation copied to clipboard!"),
          () => showToast("Failed to copy citation", true),
        );
      });
    });
  }

  function showToast(message: string, isError = false) {
    document.querySelector(".clipboard-toast")?.remove();

    const toast = document.createElement("div");
    toast.className = "clipboard-toast";
    toast.setAttribute("role", isError ? "alert" : "status");
    toast.setAttribute("aria-live", isError ? "assertive" : "polite");
    toast.setAttribute("aria-atomic", "true");
    Object.assign(toast.style, {
      position: "fixed",
      bottom: "1.5rem",
      left: "50%",
      transform: "translateX(-50%) translateY(10px)",
      padding: "0.625rem 1.25rem",
      borderRadius: "9999px",
      fontSize: "0.875rem",
      fontWeight: "500",
      color: "white",
      backgroundColor: isError ? "#b91c1c" : "#166534",
      opacity: "0",
      transition: "opacity 0.3s, transform 0.3s",
      zIndex: "9999",
      pointerEvents: "none" as const,
    });
    toast.textContent = message;
    document.body.appendChild(toast);

    requestAnimationFrame(() => {
      toast.style.opacity = "1";
      toast.style.transform = "translateX(-50%) translateY(0)";
    });

    setTimeout(() => {
      toast.style.opacity = "0";
      toast.style.transform = "translateX(-50%) translateY(10px)";
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  initPublicationCards();
  document.addEventListener("astro:after-swap", initPublicationCards);
</script>
