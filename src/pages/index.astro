---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import NewsPanel from "../components/NewsPanel.astro";
import Portrait from "../components/Portrait.astro";
---

<BaseLayout canonicalPath="/">
  <div class="mx-auto grid max-w-6xl items-start gap-6 px-4 py-8 sm:px-6 sm:py-12 lg:grid-cols-[minmax(0,1.65fr)_minmax(19rem,0.75fr)] lg:py-16">
    <div class="order-1 lg:col-start-2 lg:row-start-1">
      <Portrait />
    </div>
    <div class="order-2 lg:col-start-1 lg:row-span-2 lg:row-start-1">
      <Hero />
    </div>
    <div class="order-3 lg:col-start-2 lg:row-start-2">
      <NewsPanel />
    </div>
  </div>
</BaseLayout>
