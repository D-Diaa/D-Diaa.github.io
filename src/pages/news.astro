---
import { readFileSync } from "fs";
import { parse } from "yaml";
import NewsTimeline from "../components/NewsTimeline.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

interface NewsItem {
  date: string;
  text: string;
  href?: string;
}

const news = parse(readFileSync("src/data/news.yml", "utf-8")) as NewsItem[];
---

<BaseLayout
  title="News"
  description="Research and professional updates from Abdulrahman Diaa."
  canonicalPath="/news"
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <h1 class="mb-8 text-4xl font-bold tracking-tight text-[var(--color-text)] sm:text-5xl">News</h1>
    <section class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8" aria-label="All news">
      <NewsTimeline news={news} />
    </section>
  </div>
</BaseLayout>
